# =============================================================================
# ANNEX API - environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`.
# =============================================================================

# --- App ---
APP_NAME="ANNEX API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"
# JSON-encoded list of allowed CORS origins (["*"] for development).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
MAX_UPLOAD_SIZE_MB=10

# --- Supabase ---
# Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=""
# anon public key (used by the Auth provider to validate JWTs)
SUPABASE_ANON_KEY=""
# service role key (server-side only - used for PostgREST + Storage)
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket used for raw media uploads
SUPABASE_MEDIA_BUCKET="annex-media"

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_OCR_MODEL="gpt-4o-mini"
OPENAI_ANALYSIS_MODEL="gpt-4o-mini"