# =====================================================================
# ANNEX backend — environment template.
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is gitignored.
# Full guidance: docs/guides/installation.md
# =====================================================================

# Runtime environment: development | test | staging | production
APP_ENV=development

# Enable debug mode (docs UI, verbose logs). Never true in production.
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS origins (JSON list; pydantic-settings parses complex types as JSON).
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---------------------------------------------------------------------
# Phase 4 (database) — direct PostgreSQL endpoint.
# Local Supabase stack default; use the pooled URL in production.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------
# Phase 5 (authentication) — Firebase Admin SDK.
# Service-account JSON is a secret: keep it outside the repo (e.g. ../secrets/).
# FIREBASE_PROJECT_ID=<firebase project id>
# FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/annex-firebase-service-account.json

# ---------------------------------------------------------------------
# Phase 6 (AI + OCR) — claim analysis providers and media processing.
# OPENAI_API_KEY=<openai key>          # primary provider
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=<gemini key>          # optional second provider
# GEMINI_MODEL=gemini-2.5-flash
# OCR_LANGUAGES=eng                    # tesseract language codes

# ---------------------------------------------------------------------
# Phase 7 (async pipelines + rate limiting) — Redis and Celery (ADR-0008).
# A single local Redis instance covers broker, result backend, and the
# rate-limit counters; the Celery URLs fall back to REDIS_URL when unset.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_ANALYSIS=20/minute

# ---------------------------------------------------------------------
# Phase 8 (runtime i18n, ADR-0007) — locale bundle delivery. The default
# locale is the fallback-chain root; the TTL (seconds) drives the
# Cache-Control header clients use to cache bundles locally.
# I18N_DEFAULT_LOCALE=en
# I18N_BUNDLE_CACHE_TTL=300

# ---------------------------------------------------------------------
# Phase 4 (Observability) — Sentry, OpenTelemetry, Prometheus.
# SENTRY_DSN=https://<key>@sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# METRICS_ENABLED=true

# ---------------------------------------------------------------------
# Added in later phases — see docs/guides/installation.md for guidance.
# Uncomment and fill as each phase lands:
# ---------------------------------------------------------------------
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# FIREBASE_PROJECT_ID=<firebase project id>
# OPENAI_API_KEY=<openai key>
# GEMINI_API_KEY=<gemini key>
